# Entity: buoy

main: kit: entity: buoy: {

  alias: field: {}

  fields: [
    {
      format: "float"
      name: "air_temperature"
      req: false
      short: "Air temperature in Celsius"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "atmospheric_pressure"
      req: false
      short: "Atmospheric pressure in hPa"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "average_wave_period"
      req: false
      short: "Average wave period in seconds"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "dominant_wave_period"
      req: false
      short: "Dominant wave period in seconds"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "latitude"
      req: false
      short: "Latitude coordinate of the buoy"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "longitude"
      req: false
      short: "Longitude coordinate of the buoy"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      short: "Name of the buoy station"
      type: "`$STRING`"
    }
    {
      name: "station_id"
      req: false
      short: "Unique identifier for the buoy station"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "timestamp"
      req: false
      short: "Timestamp of the reading"
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "water_temperature"
      req: false
      short: "Water temperature in Celsius"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "wave_direction"
      req: false
      short: "Wave direction in degrees"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "wave_height"
      req: false
      short: "Significant wave height in meters"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "wind_direction"
      req: false
      short: "Wind direction in degrees"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "wind_speed"
      req: false
      short: "Wind speed in meters per second"
      type: "`$NUMBER`"
    }
  ]

  name: "buoy"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/buoys.json"
          segments: [
            {
              lit: "buoys.json"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/buoys.csv"
          segments: [
            {
              lit: "buoys.csv"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/buoys.html"
          segments: [
            {
              lit: "buoys.html"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/buoys.xml"
          segments: [
            {
              lit: "buoys.xml"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
